modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true
integrations = ["google-mail:1.0.0", "javascript_websocket:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["iana-etc", "libxcrypt", "pkg-config", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start ECG Monitor"

[[workflows.workflow]]
name = "Start ECG Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
